# Copy to .env.local and fill in. .env.local is gitignored — never commit real
# values, and never put a password here in plaintext.
#
# Generate AUTH_PASSWORD_HASH and SESSION_SECRET with:
#   npm run hash-password
#
# IMPORTANT: in a .env file every `$` in the bcrypt hash must be written as `\$`.
# Next.js expands `$VAR` when loading these files and quoting does NOT prevent
# it, so a raw hash loads corrupted and every login fails as a wrong password.
# `npm run hash-password` prints the correctly escaped form — paste that.
# Kubernetes Secrets are not affected; use the raw hash there.

AUTH_USERNAME=Jason
AUTH_PASSWORD_HASH=
SESSION_SECRET=

# ── Gmail (IMAP) — not wired up yet ──────────────────────────────────────────
# Requires 2-Step Verification on the Google account, then an App Password
# from https://myaccount.google.com/apppasswords
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_USER=
# IMAP_APP_PASSWORD=
#
# Gmail label counted by the "Work" card. Matched case-insensitively; nested
# labels use a slash, e.g. "Work/RedX". Defaults to REDX.
# IMAP_WORK_FOLDER=REDX
#
# Which signed-in Google account the "open in Gmail" links target. Gmail's URLs
# use a numeric position (u/0, u/1, ...), not an email address — 0 is the first
# account signed into the browser. Set this if the links open the wrong mailbox.
# GMAIL_ACCOUNT_INDEX=0

# ── Slack — blocked pending RedX workspace admin approval ────────────────────
# User token (xoxp-), scopes: channels:history, groups:history, im:history,
# mpim:history, users:read
# SLACK_USER_TOKEN=

# ── Request summarization — not wired up yet ─────────────────────────────────
# ANTHROPIC_API_KEY=
